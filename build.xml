<?xml version="1.0" ?>

<project name="salem" default="deftgt">
  <property file="build.properties" />

  <target name="build-env">
    <mkdir dir="build" />
    <mkdir dir="build/classes" />
    <available property="has-res-jar" file="build/salem-res.jar" />
    <available property="has-buildinfo" file="build/classes/buildinfo" />
    <available property="unpacked-lib" file="build/classes-lib" />
  </target>
  
  <target name="buildinfo" depends="build-env" unless="has-buildinfo">
    <exec executable="git" outputproperty="gitrev" failifexecutionfails="false">
      <arg line="rev-parse HEAD" />
    </exec>
    <echo file="build/classes/buildinfo" xml:space="default">
      git-rev = ${gitrev}
    </echo>
	</target>

	<target name="salem-client" depends="build-env">
		<javac srcdir="src" destdir="build/classes" debug="on" source="1.8" target="1.8" includeantruntime="no" encoding="iso-8859-1"
	   			bootclasspath="${boot-classpath}">
			<classpath>
				<pathelement path="lib/jogl-all.jar" />
				<pathelement path="lib/gluegen-rt.jar" />
				<pathelement path="lib/jnlp.jar" />
				<pathelement path="lib/jorbis.jar" />
				<pathelement path="lib/jogg.jar" />
				<pathelement path="lib/jglob.jar" />
				<pathelement path="lib/gson-2.3.jar" />
				<pathelement path="lib/guava-18.0.jar" />
			</classpath>
			<compilerarg value="-Xlint:unchecked" />
			<!-- <compilerarg value="-Xbarda" /> -->
		</javac>
		<copy todir="build/classes">
			<fileset dir="src" excludes="**/*.java" />
		</copy>
		<copy todir="build/classes/haven" file="etc/ressrv.crt" />
		<copy todir="build/classes/haven" file="etc/authsrv.crt" />
		<copy todir="build/classes/haven" file="etc/res-preload" />
		<copy todir="build/classes/haven" file="etc/res-bgload" />
		<copy todir="build/classes/haven" file="etc/icon.gif" />
	</target>

	<property name="tools" location="../tools" />
	<property name="jre21" location="${tools}/jdk-21.0.12.1+1/bin/java" />
	<property name="reports" location="build/reports" />
	<patternset id="ours">
		<include name="haven/Fayte*.java" />
		<include name="fayte/editor/*.java" />
		<include name="haven/WorldMapData.java" />
		<include name="haven/WorldMapIndex.java" />
		<include name="haven/WorldMapMarkers.java" />
		<include name="haven/WorldMapWnd.java" />
		<include name="haven/WindowSnap.java" />
		<include name="haven/MarkerPointerFX.java" />
		<include name="haven/TexHiRes.java" />
	</patternset>
	<path id="libs">
		<fileset dir="lib" includes="jogl-all.jar gluegen-rt.jar jnlp.jar jorbis.jar jogg.jar jglob.jar gson-2.3.jar guava-18.0.jar" />
	</path>

	<target name="lint" depends="salem-client">
		<mkdir dir="build/lint-classes" />
		<mkdir dir="${reports}" />
		<record name="${reports}/lint.txt" action="start" emacsmode="true" />
		<javac srcdir="src" destdir="build/lint-classes" source="1.8" target="1.8" includeantruntime="no" encoding="iso-8859-1" nowarn="no" fork="true">
			<patternset refid="ours" />
			<classpath>
				<pathelement location="build/classes" />
				<path refid="libs" />
			</classpath>
			<compilerarg value="-Xlint:all,-serial,-options" />
			<compilerarg value="-Xmaxwarns" />
			<compilerarg value="10000" />
			<compilerarg value="-implicit:none" />
		</javac>
		<record name="${reports}/lint.txt" action="stop" />
		<delete dir="build/lint-classes" />
	</target>

	<target name="pmd" depends="build-env">
		<mkdir dir="${reports}" />
		<fileset id="ours-src" dir="src"><patternset refid="ours" /></fileset>
		<pathconvert property="ours-list" refid="ours-src" pathsep="," />
		<java classname="net.sourceforge.pmd.cli.PmdCli" fork="true" jvm="${jre21}" failonerror="false">
			<classpath><fileset dir="${tools}/pmd-bin-7.28.0/lib" includes="*.jar" /></classpath>
			<arg line="check --no-cache --no-progress -R etc/checks/pmd-rules.xml -f text --use-version java-1.8 --encoding ISO-8859-1" />
			<arg value="-r" />
			<arg value="${reports}/pmd.txt" />
			<arg value="-d" />
			<arg value="${ours-list}" />
		</java>
		<java classname="net.sourceforge.pmd.cli.PmdCli" fork="true" jvm="${jre21}" failonerror="false" output="${reports}/cpd.txt">
			<classpath><fileset dir="${tools}/pmd-bin-7.28.0/lib" includes="*.jar" /></classpath>
			<arg line="cpd --minimum-tokens 100 --language java --encoding ISO-8859-1 --no-fail-on-violation" />
			<arg value="-d" />
			<arg value="${ours-list}" />
		</java>
	</target>

	<target name="spotbugs" depends="salem-client">
		<mkdir dir="${reports}" />
		<delete dir="build/ours-classes" />
		<copy todir="build/ours-classes">
			<fileset dir="build/classes">
				<include name="haven/Fayte*.class" />
				<include name="fayte/editor/*.class" />
				<include name="haven/WorldMapData*.class" />
				<include name="haven/WorldMapIndex*.class" />
				<include name="haven/WorldMapMarkers*.class" />
				<include name="haven/WorldMapWnd*.class" />
				<include name="haven/WindowSnap*.class" />
				<include name="haven/MarkerPointerFX*.class" />
				<include name="haven/TexHiRes*.class" />
			</fileset>
		</copy>
		<pathconvert property="aux" pathsep=";">
			<path><pathelement location="build/classes" /><path refid="libs" /></path>
		</pathconvert>
		<java jar="${tools}/spotbugs-4.10.4/lib/spotbugs.jar" fork="true" jvm="${jre21}" failonerror="false" maxmemory="2g">
			<arg line="-textui -effort:max -low -xml:withMessages -exclude etc/checks/spotbugs-exclude.xml" />
			<arg value="-output" />
			<arg value="${reports}/spotbugs.xml" />
			<arg value="-auxclasspath" />
			<arg value="${aux}" />
			<arg value="build/ours-classes" />
		</java>
		<delete dir="build/ours-classes" />
	</target>

	<target name="checks" depends="lint,pmd,spotbugs" />

	<target name="format">
		<apply executable="${jre21}" parallel="true" failonerror="true">
			<arg value="--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED" />
			<arg value="--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED" />
			<arg value="--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED" />
			<arg value="--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED" />
			<arg value="--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED" />
			<arg value="--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED" />
			<arg value="-cp" />
			<arg value="${tools}/palantir/lib/*" />
			<arg value="com.palantir.javaformat.java.Main" />
			<arg value="--palantir" />
			<arg value="--replace" />
			<srcfile />
			<fileset dir="src"><patternset refid="ours" /></fileset>
		</apply>
	</target>

	<target name="copy-certificates">
		<copy todir="out/production/salem/haven" file="etc/ressrv.crt" />
		<copy todir="out/production/salem/haven" file="etc/authsrv.crt" />
		<copy todir="out/production/salem/haven" file="etc/res-preload" />
		<copy todir="out/production/salem/haven" file="etc/res-bgload" />
		<copy todir="out/production/salem/haven" file="etc/icon.gif" />
	</target>

	<target name="appletview" depends="build-env">
		<copy file="etc/applet.html" todir="build" />
	</target>

	<target name="lib-classes" depends="build-env" unless="unpacked-lib">
		<mkdir dir="build/classes-lib" />
		<unjar src="lib/jogg.jar" dest="build/classes-lib">
			<patternset excludes="META-INF/**" />
		</unjar>
		<unjar src="lib/jorbis.jar" dest="build/classes-lib">
			<patternset excludes="META-INF/**" />
		</unjar>
		<unjar src="lib/jglob.jar" dest="build/classes-lib">
			<patternset excludes="META-INF/**" />
		</unjar>
		<unjar src="lib/gson-2.3.jar" dest="build/classes-lib">
			<patternset excludes="META-INF/**" />
		</unjar>
		<unjar src="lib/guava-18.0.jar" dest="build/classes-lib">
			<patternset excludes="META-INF/**" />
		</unjar>
	</target>

	<target name="resources">
		<java jar="resources/LayerUtil.jar" fork="true" >
			<arg line="-re resources/src resources/compiled/res"/>
		</java>
		<jar destfile="build/lclient-res.jar" update="true">
			<fileset dir="resources/compiled" />
			<fileset dir="resources/item_data" />
		</jar>
	</target>

	<target name="jar" depends="salem-client,buildinfo,lib-classes,resources">
		<jar destfile="build/fayte.jar" update="true">
			<fileset dir="build/classes" excludes="fayte/editor/**"/>
			<fileset dir="resources/compiled" includes="res/paginae/add/fayte.res res/paginae/add/gatherwindows.res res/paginae/add/worldmap.res res/paginae/add/chatwindow.res res/paginae/add/classicchat.res res/paginae/add/almanac.res res/paginae/add/lockui.res res/paginae/add/keybinds.res res/paginae/add/modules.res res/paginae/add/view.res res/paginae/add/tools.res res/paginae/add/ftimers.res res/paginae/add/selections.res" />
			<fileset dir="build/classes-lib" />
			<fileset file="changelog.txt" />
			<fileset file="etc/radar.xml" />
			<fileset file="etc/timer.wav" />
			<fileset file="etc/trans.txt" />
			<fileset file="etc/contents_icons.json" />
                        <fileset file="etc/item_radius.json" />
                        <fileset file="etc/gob_path.json" />
			<fileset file="etc/item_data.json" />
			<fileset dir="etc" includes="fayte/*.json fayte/*.json.gz fayte/*.txt fayte/*.properties fayte/entries/** fayte/profiles/**" />
			<manifest>
				<attribute name="Main-Class" value="haven.MainFrame" />
				<attribute name="Class-Path" value="jogl-all.jar gluegen-rt.jar lclient-res.jar builtin-res.jar salem-res.jar gson-2.3.jar guava-18.0.jar" />
			</manifest>
		</jar>
		<chmod file="build/fayte.jar" perm="a+x" />
	</target>

	<target name="editor" depends="jar">
		<jar destfile="build/entry_editor.jar">
			<zipfileset src="build/fayte.jar" excludes="META-INF/MANIFEST.MF" />
			<fileset dir="build/classes" includes="fayte/editor/**" />
			<manifest>
				<attribute name="Main-Class" value="fayte.editor.EntryEditor" />
				<attribute name="Class-Path" value="../lib/jogl-all.jar ../lib/gluegen-rt.jar" />
			</manifest>
		</jar>
	</target>

	<target name="res-jar" depends="build-env" unless="has-res-jar">
		<get src="http://game.salemthegame.com/java/salem-res.jar" dest="lib/salem-res.jar" usetimestamp="true" />
		<get src="http://game.salemthegame.com/java/builtin-res.jar" dest="lib/builtin-res.jar" usetimestamp="true" />
	</target>

	<target name="jars" depends="build-env, jar, res-jar">
		<copy todir="build">
			<fileset dir="lib">
				<include name="jogl-all.jar" />
				<include name="gluegen-rt.jar" />
				<include name="salem-res.jar" />
				<include name="builtin-res.jar" />
			</fileset>
		</copy>
	</target>

	<target name="deftgt" depends="jars, appletview" />

	<target name="run" depends="jars">
		<java jar="build/fayte.jar" 
				dir="build" 
				fork="true" 
				maxmemory="1024m"
				classpath="java">
			<arg line="-d -U http://game.salemthegame.com/res/ game.salemthegame.com"/>
                        <jvmarg line="-XX:-UseGCOverheadLimit" />
		</java>
	</target>

    <target name="debug" depends="jars">
		<java jar="build/fayte.jar"
				dir="build"
				fork="true"
				maxmemory="1024m"
				classpath="java">
			<arg line="-d -U http://game.salemthegame.com/res/ game.salemthegame.com"/>
                        <jvmarg line="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5005 -XX:-UseGCOverheadLimit" />
		</java>
	</target>

	<target name="clean">
                <delete file="build/fayte.jar" />
                <delete file="build/lclient-res.jar" />
		<delete dir="build/classes" />
		<delete dir="build/classes-lib" />
		<delete dir="resources/compiled" />
	</target>
</project>
